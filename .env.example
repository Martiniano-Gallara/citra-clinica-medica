# ====================================================================
# CITRA · Centro Integral de Traumatología & Rehabilitación Arroyito
# VARIABLES DE ENTORNO OBLIGATORIAS (Auditoría B-04)
# ====================================================================
# INSTRUCCIONES:
# Copie este archivo como '.env' en la raíz del proyecto antes de iniciar:
#   cp .env.example .env
#
# En entornos de producción (Vercel / Cloud), estas variables DEBEN
# configurarse en el panel de Environment Variables. La aplicación fallará
# de manera explícita con pantalla de error si faltan estas variables.
# ====================================================================

# URL del proyecto Supabase (encontrada en Project Settings > API)
# Debe ser una URL válida con protocolo https:// finalizando en .supabase.co
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key) con Row Level Security activado
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Entorno de ejecución de la aplicación: 'production' | 'development'
VITE_APP_ENV=production
