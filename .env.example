# CITRA · Centro Integral de Traumatología & Rehabilitación Arroyito
# VARIABLES DE ENTORNO PARA PRODUCCIÓN (Vercel & Supabase Cloud)
# ====================================================================

# URL del proyecto Supabase (encontrada en Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (anon public key) con Row Level Security activado
VITE_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Modo de ejecución (production / development)
VITE_APP_ENV=production
